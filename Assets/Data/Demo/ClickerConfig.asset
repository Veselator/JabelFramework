      expression: 0.9 ^ count('open_space')
    format:
      notation: 0
      decimals: 2
      smallDecimals: 0
      trimZeros: 1
  - key: upgradeDiscount
    displayName:
      key: 
    formula:
      expression: 0.85 ^ count('mentor')
    format:
      notation: 0
      decimals: 2
      smallDecimals: 0
      trimZeros: 1
