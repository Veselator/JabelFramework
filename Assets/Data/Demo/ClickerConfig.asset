  derivedValues:
  - key: clickPower
    displayName:
      key: 
    formula:
      expression: (1 + count('mech_keyboard')) * 2 ^ count('coffee')
    format:
      notation: 0
      decimals: 2
      smallDecimals: 0
      trimZeros: 1
  - key: critChance
    displayName:
      key: 
    formula:
      expression: 0.05 * count('rubber_duck')
    format:
      notation: 0
      decimals: 2
      smallDecimals: 0
      trimZeros: 1
  - key: officeComfort
    displayName:
      key: 
    formula:
      expression: 1 + 0.25 * count('office_style')
    format:
      notation: 0
      decimals: 2
      smallDecimals: 0
      trimZeros: 1
  - key: officeStyle
    displayName:
      key: 
    formula:
      expression: count('office_style')
    format:
      notation: 0
      decimals: 2
      smallDecimals: 0
      trimZeros: 1
  - key: incomePerChar
    displayName:
      key: 
    formula:
      expression: 0.1 * 1.5 ^ count('stack_overflow') * 2 ^ count('shakespeare')
        * officeComfort
    format:
      notation: 0
      decimals: 2
      smallDecimals: 0
      trimZeros: 1
  - key: levelReward
    displayName:
      key: 
    formula:
      expression: 10 * playerLevel * 2 ^ count('code_review') * 2 ^ count('shakespeare')
    format:
      notation: 0
      decimals: 2
      smallDecimals: 0
      trimZeros: 1
  - key: linesForNextLevel
    displayName:
      key: 
    formula:
      expression: floor(20 * 2.5 ^ (playerLevel - 1))
    format:
      notation: 0
      decimals: 2
      smallDecimals: 0
      trimZeros: 1
  - key: monkeySpeed
    displayName:
      key: 
    formula:
      expression: 0.9 ^ count('bananas')
    format:
      notation: 0
      decimals: 2
      smallDecimals: 0
      trimZeros: 1
  - key: monkeyBonus
